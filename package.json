{
    "name": "pos-backend",
    "version": "1.0.0",
    "description": "POS Backend API with Supabase",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node server.js",
        "test-db": "node test-connection.js",
        "test-notify": "node test-notification.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "eval:ai": "jest --testMatch=\"**/tests/ai-eval/*.eval.js\" --runInBand --testTimeout=180000",
        "eval:prompt": "jest --testMatch=\"**/tests/ai-eval/promptTechniques.eval.js\" --runInBand --testTimeout=300000",
        "eval:ocr": "jest --testMatch=\"**/tests/ai-eval/ocrExpiry.eval.js\" --runInBand --testTimeout=300000"
    },
    "keywords": [
        "pos",
        "supabase",
        "api"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@supabase/supabase-js": "^2.39.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.22.1",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.1",
        "helmet": "^7.2.0",
        "multer": "^2.0.2",
        "promptpay-qr": "^0.5.0"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "supertest": "^7.2.2"
    }
}
